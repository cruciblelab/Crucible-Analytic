# Crucible Analytic: schema upgrader.
#
# Started by crucible-upgrader.timer, not by multi-user.target - hence no
# [Install] section. `systemctl enable --now crucible-upgrader.timer` is
# what turns this on; enabling the service itself would run it once at
# boot and never again.
[Unit]
Description=Crucible Analytic schema upgrader
Documentation=file:/opt/crucible-analytic/KURULUM.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
# One pass, then exit. Nothing to serve and nothing to keep warm, so a
# machine at rest holds no process with DDL rights on an open connection.
Type=oneshot
ExecStart=/opt/crucible-analytic/bin/upgrader -config /etc/crucible-analytic/upgrader.toml -once

# Its own account, and this is the point of the whole arrangement rather
# than tidiness. upgrader.toml carries the only DSN in the deployment that
# can run DDL. The four services run as `crucible`; if this ran as
# `crucible` too, then the panel - which is `crucible` - could read the
# credential that rewrites its own database, and the separation the five
# roles buy would be undone by a file permission.
User=crucible-upgrader
Group=crucible-upgrader

# Deliberately absent: Restart=.
#
# The other four units restart forever because a serving process that is
# down is an outage. This is a timer job: a failed run must stay failed
# and visible in `systemctl status`, and the next tick tries again thirty
# seconds later anyway. Restarting it would turn one recorded failure into
# a loop nobody reads.
#
# Also absent: StartLimitBurst/StartLimitIntervalSec. They bound a restart
# loop, and there is no restart here to bound. A directive copied from a
# neighbouring unit because the neighbour has it is how a file stops
# meaning what it says.

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# The state directory, and nothing else.
#
# # Why this line was missing, and what it cost
#
# It used to say "no ReadWritePaths, and it is a decision", because this
# unit logs to the journal rather than to a file: `journalctl -u
# crucible-upgrader` is one place to look instead of two. That was
# true, and it stopped being true the day the upgrader started writing
# backups.
#
# Nothing noticed. ProtectSystem=strict makes the whole filesystem
# read-only for this unit, so every backup on every systemd install
# failed with "read-only file system" - a message the customer cannot
# act on, on a page where they had just pressed a button. Measured with
# the real binary in a mount namespace that reproduces the sandbox.
#
# It got worse before it was found: the upgrade now takes a backup
# before touching the schema and stops when one fails, so a deployment
# that configured a backup directory could no longer upgrade either.
#
# # Why the state directory and not the configured path
#
# systemd cannot read upgrader.toml, so the writable path has to be
# fixed here while the backup directory is chosen there. The two are
# reconciled by putting the directory under this one - which is what
# the configuration already recommends, for the container's sake, and
# is now what it requires.
#
# The upgrader checks at startup that its backup directory is actually
# writable and says so if it is not, so an operator who points it
# somewhere else learns from the journal rather than from a customer.
#
# The leading `-` keeps a machine that has no state directory yet from
# failing to start the unit: a deployment with no backups configured
# never needs the path, and refusing to run the schema upgrader over a
# directory it was not going to use would be the cure being worse.
ReadWritePaths=-/var/lib/crucible-analytic

CapabilityBoundingSet=
