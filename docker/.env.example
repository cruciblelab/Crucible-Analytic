# Copy to .env and fill in. `docker compose` reads it automatically.

# The database superuser's password. Generated once and never typed
# again - the services get their own roles and their own passwords,
# which the init step generates and writes into the config volume.
#
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The site id every stored row is keyed by.
#
# Irreversible. Changing it later does not rename anything: it starts a
# second site whose history begins today, and the old rows stay under the
# old name. Pick the customer's short name and keep it.
SITE_ID=musteri

# What the collector proxies to - the customer's own website, as
# host:port. In passthrough mode (the default) the bytes are forwarded
# without being decrypted, so this must be something that can finish a
# TLS handshake itself.
#
# Another container on this network: use its service name, e.g.
# site:443. A server outside: its address.
SITE_BACKEND=site:443

# Where the collector is published on the host. 443 for a live site;
# change it only if something else already has that port.
COLLECTOR_PORT=443

# Where the beacon is published. The snippet in the customer's pages
# posts here from the visitor's browser, so it has to be reachable -
# put it behind the same reverse proxy that terminates TLS for the site.
BEACON_PORT=8081

# The image to run. Build it with:
#
#   docker build -t crucible-analytic:$(git describe --tags --always) .
#
CA_IMAGE=crucible-analytic:dev
